<style>
  .alva-hero {
    position: relative;
    width: 100%;
    height: calc(100vh - var(--header-height));
    min-height: 560px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }

  @media (min-width: 1024px) {
    .alva-hero {
      height: 90vh;
      min-height: 720px;
      max-height: 900px;
    }
  }

  .alva-hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .alva-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 40%, rgba(26, 26, 24, 0.45) 100%);
    pointer-events: none;
  }

  .alva-hero__content {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: 0 var(--container-pad) var(--sp-16);
  }

  @media (min-width: 1024px) {
    .alva-hero__content {
      padding-bottom: var(--sp-20);
    }
  }

  .alva-hero__text {
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
  }

  @media (min-width: 1024px) {
    .alva-hero__text {
      margin: 0;
      text-align: left;
      max-width: 560px;
    }
  }

  .alva-hero__eyebrow {
    font-family: var(--font-body);
    font-size: var(--font-eyebrow);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(250, 248, 244, 0.8);
    margin-bottom: var(--sp-6);
    display: block;
  }

  .alva-hero__heading {
    font-family: var(--font-heading);
    font-size: var(--font-display-xl);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--paper);
    margin-bottom: var(--sp-6);
  }

  .alva-hero__subhead {
    font-family: var(--font-body);
    font-size: var(--font-body-lg);
    font-weight: 300;
    line-height: 1.65;
    color: rgba(250, 248, 244, 0.9);
    margin-bottom: var(--sp-10);
    max-width: 480px;
  }

  @media (min-width: 1024px) {
    .alva-hero__subhead {
      margin-bottom: var(--sp-10);
    }
  }

  .alva-hero__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    font-family: var(--font-body);
    font-size: var(--font-ui-md);
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--paper);
    border: 1px solid var(--paper);
    background: transparent;
    text-decoration: none;
    padding: 16px 32px;
    transition: background-color 150ms ease-out, color 150ms ease-out;
    border-radius: 0;
  }

  @media (min-width: 1024px) {
    .alva-hero__cta {
      padding: 18px 40px;
    }
  }

  .alva-hero__cta:hover {
    background-color: var(--paper);
    color: var(--ink);
    text-decoration: none;
  }

  .alva-hero__cta svg {
    width: 16px;
    height: 16px;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex-shrink: 0;
    transition: transform 150ms ease-out;
  }

  .alva-hero__cta:hover svg {
    transform: translateX(4px);
  }

  /* No-image fallback */
  .alva-hero--no-image {
    background-color: var(--ink);
  }
</style>

{%- assign hero_image = section.settings.image -%}

<section class="alva-hero{% unless hero_image %} alva-hero--no-image{% endunless %}">
  {%- if hero_image -%}
    <img
      class="alva-hero__image"
      src="{{ hero_image | image_url: width: 1920 }}"
      srcset="
        {{ hero_image | image_url: width: 480 }} 480w,
        {{ hero_image | image_url: width: 768 }} 768w,
        {{ hero_image | image_url: width: 1280 }} 1280w,
        {{ hero_image | image_url: width: 1920 }} 1920w
      "
      sizes="100vw"
      alt="{{ hero_image.alt | escape | default: section.settings.heading }}"
      fetchpriority="high"
      width="{{ hero_image.width }}"
      height="{{ hero_image.height }}"
    >
  {%- endif -%}

  <div class="alva-hero__overlay" aria-hidden="true"></div>

  <div class="alva-hero__content">
    <div class="alva-hero__text">
      {%- if section.settings.eyebrow != blank -%}
        <span class="alva-hero__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="alva-hero__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.subhead != blank -%}
        <p class="alva-hero__subhead">{{ section.settings.subhead }}</p>
      {%- endif -%}

      {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
        <a href="{{ section.settings.cta_link }}" class="alva-hero__cta">
          {{ section.settings.cta_label }}
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Portuguese Soft Tailoring"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The unstructured blazer."
    },
    {
      "type": "text",
      "id": "subhead",
      "label": "Subheading",
      "default": "Made in our own factory, in seven fabrics. From €490."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "See the blazer"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "ALVA Hero"
    }
  ]
}
{% endschema %}
