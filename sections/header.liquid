<link rel="stylesheet" href="{{ 'component-menu-drawer.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-cart-notification.css' | asset_url }}" media="print" onload="this.media='all'">

<style>
  /* ============================================================
     ALVA HEADER
     ============================================================ */

  .alva-header-section {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: var(--header-height);
    background-color: var(--paper);
    border-bottom: 1px solid transparent;
    transition: border-color 200ms ease-out;
  }

  .alva-header-section.alva-header--scrolled {
    border-bottom-color: var(--sand);
  }

  .alva-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 100%;
    padding: 0 var(--container-pad);
    max-width: var(--container-max);
    margin: 0 auto;
  }

  /* ---- LEFT ZONE ---- */
  .alva-header__left {
    display: flex;
    align-items: center;
  }

  /* Desktop nav — hidden on mobile */
  .alva-header__nav {
    display: none;
  }

  @media (min-width: 1024px) {
    .alva-header__nav {
      display: flex;
      align-items: center;
      gap: var(--sp-8);
      list-style: none;
      margin: 0;
      padding: 0;
    }
  }

  .alva-header__nav-item a {
    font-family: var(--font-body);
    font-size: var(--font-ui-md);
    font-weight: 400;
    color: var(--ink);
    text-decoration: none;
    letter-spacing: 0;
    line-height: 1;
    transition: color 150ms ease-out;
  }

  .alva-header__nav-item a:hover {
    color: var(--warm);
    text-decoration: none;
  }

  /* Hamburger — visible on mobile only */
  .alva-header__hamburger-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    width: 24px;
    height: 24px;
    color: var(--ink);
  }

  .alva-header__hamburger-btn svg {
    width: 24px;
    height: 24px;
    stroke: var(--ink);
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  @media (min-width: 1024px) {
    .alva-header__hamburger-btn {
      display: none;
    }
  }

  /* ---- CENTRE ZONE — WORDMARK ---- */
  .alva-header__wordmark {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .alva-header__wordmark-link {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: var(--ink);
    text-decoration: none;
    text-transform: uppercase;
    line-height: 1;
    display: block;
    width: 90px;
    text-align: center;
    transition: color 150ms ease-out;
  }

  .alva-header__wordmark-link:hover {
    color: var(--ink);
    text-decoration: none;
  }

  @media (min-width: 1024px) {
    .alva-header__wordmark-link {
      font-size: 24px;
      width: 120px;
    }
  }

  /* ---- RIGHT ZONE ---- */
  .alva-header__right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--sp-8);
  }

  .alva-header__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink);
    text-decoration: none;
    position: relative;
    transition: color 150ms ease-out;
    line-height: 1;
  }

  .alva-header__icon:hover {
    color: var(--warm);
    text-decoration: none;
  }

  .alva-header__icon svg {
    width: 20px;
    height: 20px;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    display: block;
  }

  /* Account hidden on mobile */
  .alva-header__icon--account {
    display: none;
  }

  @media (min-width: 1024px) {
    .alva-header__icon--account {
      display: flex;
    }
  }

  .alva-cart-count {
    position: absolute;
    top: -5px;
    right: -7px;
    min-width: 15px;
    height: 15px;
    background-color: var(--ink);
    color: var(--paper);
    font-family: var(--font-body);
    font-size: 9px;
    font-weight: 500;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 3px;
    line-height: 1;
  }

  /* ---- MOBILE DRAWER OVERRIDES ---- */
  .alva-mobile-drawer {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: min(320px, 85vw);
    background-color: var(--paper);
    z-index: 200;
    transform: translateX(-100%);
    transition: transform 300ms ease-out;
    overflow-y: auto;
    padding: var(--sp-8) var(--sp-6);
  }

  .alva-mobile-drawer.is-open {
    transform: translateX(0);
  }

  .alva-mobile-drawer__overlay {
    position: fixed;
    inset: 0;
    background-color: rgba(26, 26, 24, 0.5);
    z-index: 199;
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms ease-out;
  }

  .alva-mobile-drawer__overlay.is-open {
    opacity: 1;
    pointer-events: all;
  }

  .alva-mobile-drawer__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--sp-12);
    padding-bottom: var(--sp-6);
    border-bottom: 1px solid var(--sand);
  }

  .alva-mobile-drawer__close {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: var(--ink);
    display: flex;
    align-items: center;
  }

  .alva-mobile-drawer__close svg {
    width: 20px;
    height: 20px;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  .alva-mobile-drawer__nav {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }

  .alva-mobile-drawer__nav a {
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 300;
    color: var(--ink);
    text-decoration: none;
    display: block;
    padding: var(--sp-2) 0;
    transition: color 150ms ease-out;
  }

  .alva-mobile-drawer__nav a:hover {
    color: var(--warm);
    text-decoration: none;
  }

  .alva-mobile-drawer__footer {
    margin-top: var(--sp-12);
    padding-top: var(--sp-6);
    border-top: 1px solid var(--sand);
  }

  .alva-mobile-drawer__footer a {
    font-family: var(--font-body);
    font-size: var(--font-body-sm);
    font-weight: 400;
    color: var(--stone);
    text-decoration: none;
    display: block;
    padding: var(--sp-2) 0;
  }
</style>

<sticky-header class="alva-header-section shopify-section-header-sticky" data-sticky-type="{{ section.settings.sticky_header_type }}">
  <div class="alva-header__inner">

    <!-- LEFT: hamburger (mobile) / nav links (desktop) -->
    <div class="alva-header__left">
      <button
        class="alva-header__hamburger-btn"
        type="button"
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="alva-mobile-drawer"
        id="alva-hamburger-btn"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <line x1="3" y1="7" x2="21" y2="7"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="17" x2="21" y2="17"/>
        </svg>
      </button>

      <nav aria-label="Main navigation">
        <ul class="alva-header__nav">
          {%- for link in section.settings.menu.links -%}
            <li class="alva-header__nav-item">
              <a href="{{ link.url }}">{{ link.title }}</a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    </div>

    <!-- CENTRE: wordmark -->
    <div class="alva-header__wordmark">
      {%- if request.page_type == 'index' -%}
        <h1 style="margin:0;font-size:inherit;font-weight:inherit;line-height:inherit;">
          <a href="{{ routes.root_url }}" class="alva-header__wordmark-link">ALVA</a>
        </h1>
      {%- else -%}
        <a href="{{ routes.root_url }}" class="alva-header__wordmark-link">ALVA</a>
      {%- endif -%}
    </div>

    <!-- RIGHT: account + cart -->
    <div class="alva-header__right">
      {%- if shop.customer_accounts_enabled -%}
        <a
          href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
          class="alva-header__icon alva-header__icon--account"
          aria-label="{{ 'customer.account_fallback' | t }}"
          rel="nofollow"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="8" r="4"/>
            <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
          </svg>
        </a>
      {%- endif -%}

      <a
        href="{{ routes.cart_url }}"
        class="alva-header__icon alva-header__icon--cart"
        aria-label="{{ 'templates.cart.cart' | t }}"
        id="cart-icon-bubble"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 01-8 0"/>
        </svg>
        {%- if cart.item_count > 0 -%}
          <span class="alva-cart-count" aria-hidden="true">{{ cart.item_count }}</span>
        {%- endif -%}
        <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
      </a>
    </div>

  </div>
</sticky-header>

<!-- Mobile drawer overlay -->
<div
  class="alva-mobile-drawer__overlay"
  id="alva-drawer-overlay"
  aria-hidden="true"
></div>

<!-- Mobile drawer -->
<div
  class="alva-mobile-drawer"
  id="alva-mobile-drawer"
  role="dialog"
  aria-label="Navigation"
  aria-modal="true"
  hidden
>
  <div class="alva-mobile-drawer__header">
    <span class="alva-header__wordmark-link" style="font-family:var(--font-heading);font-size:20px;font-weight:400;letter-spacing:0.08em;text-transform:uppercase;color:var(--ink);">ALVA</span>
    <button
      class="alva-mobile-drawer__close"
      type="button"
      aria-label="Close navigation"
      id="alva-drawer-close"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <nav aria-label="Mobile navigation">
    <ul class="alva-mobile-drawer__nav">
      {%- for link in section.settings.menu.links -%}
        <li><a href="{{ link.url }}">{{ link.title }}</a></li>
      {%- endfor -%}
    </ul>
  </nav>

  <div class="alva-mobile-drawer__footer">
    {%- if shop.customer_accounts_enabled -%}
      <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}">
        {%- if customer -%}Account{%- else -%}Sign in{%- endif -%}
      </a>
    {%- endif -%}
  </div>
</div>

{%- if settings.cart_type == "notification" -%}
  {%- render 'cart-notification', color_scheme: section.settings.color_scheme, desktop_menu_type: section.settings.menu_type_desktop -%}
{%- endif -%}

<script>
  (function() {
    const hamburger = document.getElementById('alva-hamburger-btn');
    const drawer = document.getElementById('alva-mobile-drawer');
    const overlay = document.getElementById('alva-drawer-overlay');
    const closeBtn = document.getElementById('alva-drawer-close');

    function openDrawer() {
      drawer.hidden = false;
      requestAnimationFrame(() => {
        drawer.classList.add('is-open');
        overlay.classList.add('is-open');
      });
      hamburger.setAttribute('aria-expanded', 'true');
      overlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      drawer.classList.remove('is-open');
      overlay.classList.remove('is-open');
      hamburger.setAttribute('aria-expanded', 'false');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      setTimeout(() => { drawer.hidden = true; }, 300);
    }

    if (hamburger) hamburger.addEventListener('click', openDrawer);
    if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
    if (overlay) overlay.addEventListener('click', closeDrawer);

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && drawer && !drawer.hidden) closeDrawer();
    });
  })();
</script>

{% javascript %}
  class StickyHeader extends HTMLElement {
    constructor() {
      super();
    }

    connectedCallback() {
      this.header = document.querySelector('.alva-header-section');
      this.headerIsAlwaysSticky = this.getAttribute('data-sticky-type') === 'always' || this.getAttribute('data-sticky-type') === 'reduce-logo-size';
      this.headerBounds = {};
      this.currentScrollTop = 0;
      this.preventReveal = false;

      this.onScrollHandler = this.onScroll.bind(this);
      window.addEventListener('scroll', this.onScrollHandler, { passive: true });
      this.createObserver();
    }

    disconnectedCallback() {
      window.removeEventListener('scroll', this.onScrollHandler);
    }

    createObserver() {
      let observer = new IntersectionObserver((entries) => {
        this.headerBounds = entries[0].intersectionRect;
        observer.disconnect();
      });
      observer.observe(this.header || this);
    }

    onScroll() {
      const scrollTop = window.pageYOffset || document.documentElement.scrollTop;

      if (scrollTop > 80) {
        this.classList.add('alva-header--scrolled');
      } else {
        this.classList.remove('alva-header--scrolled');
      }

      this.currentScrollTop = scrollTop;
    }
  }

  customElements.define('sticky-header', StickyHeader);
{% endjavascript %}

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ request.origin | append: page.url | json }}
  }
</script>

{%- if request.page_type == 'index' -%}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "url": {{ request.origin | append: page.url | json }}
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Navigation menu"
    },
    {
      "type": "select",
      "id": "sticky_header_type",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "always", "label": "Always" }
      ],
      "default": "always",
      "label": "Sticky header"
    }
  ],
  "blocks": []
}
{% endschema %}
