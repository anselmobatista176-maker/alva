<style>
  .alva-pillars {
    background-color: var(--paper);
    padding: var(--sp-20) var(--container-pad);
  }

  @media (min-width: 1024px) {
    .alva-pillars {
      padding: var(--sp-40) var(--container-pad);
    }
  }

  .alva-pillars__inner {
    max-width: var(--container-max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-12);
  }

  @media (min-width: 1024px) {
    .alva-pillars__inner {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--sp-20);
    }
  }

  .alva-pillars__item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .alva-pillars__number {
    font-family: var(--font-body);
    font-size: var(--font-eyebrow);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--stone);
    margin-bottom: var(--sp-12);
    display: block;
  }

  .alva-pillars__heading {
    font-family: var(--font-heading);
    font-size: var(--font-display-md);
    font-weight: 300;
    font-style: italic;
    line-height: 1.2;
    color: var(--ink);
    margin-bottom: var(--sp-6);
  }

  .alva-pillars__body {
    font-family: var(--font-body);
    font-size: var(--font-body-lg);
    font-weight: 300;
    line-height: 1.65;
    color: var(--charcoal);
  }
</style>

<section class="alva-pillars">
  <div class="alva-pillars__inner">

    {%- for block in section.blocks -%}
      <div class="alva-pillars__item" {{ block.shopify_attributes }}>
        <span class="alva-pillars__number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
        {%- if block.settings.heading != blank -%}
          <h2 class="alva-pillars__heading">{{ block.settings.heading }}</h2>
        {%- endif -%}
        {%- if block.settings.body != blank -%}
          <p class="alva-pillars__body">{{ block.settings.body }}</p>
        {%- endif -%}
      </div>
    {%- endfor -%}

  </div>
</section>

{% schema %}
{
  "name": "Three pillars",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Versatile by design."
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body text",
          "default": "One construction, seven fabrics. The same blazer worn to a board meeting or a Saturday lunch — what changes is the cloth."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Three pillars",
      "blocks": [
        {
          "type": "pillar",
          "settings": {
            "heading": "Versatile by design.",
            "body": "One construction, seven fabrics. The same blazer worn to a board meeting or a Saturday lunch — what changes is the cloth."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "heading": "Made in our factory.",
            "body": "Our factory in Central Portugal has been making outerwear since 1981. 30,000 garments a year, for European brands you'd recognise in the best stores on the continent."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "heading": "Honest from the start.",
            "body": "No shoulder padding, no canvas, no lining. Exposed seams bound by hand. The cloth from VBC, Reda, Drago, and Dormeuil — mills that have been weaving since the seventeenth century."
          }
        }
      ]
    }
  ]
}
{% endschema %}
