<style>
  .alva-journal {
    background-color: var(--paper);
    padding: var(--sp-32) var(--container-pad);
  }

  @media (min-width: 1024px) {
    .alva-journal {
      padding: var(--sp-32) var(--container-pad);
    }
  }

  .alva-journal__inner {
    max-width: var(--container-max);
    margin: 0 auto;
  }

  .alva-journal__header {
    text-align: center;
    margin-bottom: var(--sp-16);
  }

  .alva-journal__eyebrow {
    font-family: var(--font-body);
    font-size: var(--font-eyebrow);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--stone);
    margin-bottom: var(--sp-8);
    display: block;
  }

  .alva-journal__heading {
    font-family: var(--font-heading);
    font-size: var(--font-display-md);
    font-weight: 300;
    line-height: 1.15;
    color: var(--ink);
  }

  /* Card grid */
  .alva-journal__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-10);
    margin-bottom: var(--sp-16);
  }

  @media (min-width: 768px) {
    .alva-journal__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .alva-journal__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--sp-8);
    }
  }

  .alva-journal__card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
  }

  .alva-journal__card:hover {
    text-decoration: none;
  }

  .alva-journal__card-image-wrap {
    overflow: hidden;
    margin-bottom: var(--sp-6);
  }

  .alva-journal__card-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
    transition: opacity 200ms ease-out;
  }

  .alva-journal__card:hover .alva-journal__card-image {
    opacity: 0.9;
  }

  .alva-journal__card-category {
    font-family: var(--font-body);
    font-size: var(--font-eyebrow);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--stone);
    margin-bottom: var(--sp-2);
    display: block;
  }

  .alva-journal__card-title {
    font-family: var(--font-heading);
    font-size: var(--font-display-sm);
    font-weight: 300;
    line-height: 1.2;
    color: var(--ink);
    margin-bottom: var(--sp-3);
  }

  .alva-journal__card-meta {
    font-family: var(--font-body);
    font-size: var(--font-meta);
    font-weight: 400;
    color: var(--stone);
    line-height: 1.4;
  }

  .alva-journal__cta {
    text-align: center;
  }

  .alva-journal__link {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-family: var(--font-body);
    font-size: var(--font-body-md);
    font-weight: 400;
    color: var(--charcoal);
    text-decoration: underline;
    text-decoration-color: var(--sand);
    text-underline-offset: 4px;
    transition: color 150ms ease-out, text-decoration-color 150ms ease-out;
  }

  .alva-journal__link:hover {
    color: var(--warm);
    text-decoration-color: var(--warm);
    text-decoration: underline;
  }

  .alva-journal__link svg {
    width: 16px;
    height: 16px;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>

{%- assign blog = blogs[section.settings.blog] -%}

<section class="alva-journal">
  <div class="alva-journal__inner">

    <div class="alva-journal__header">
      <span class="alva-journal__eyebrow">Journal</span>
      <h2 class="alva-journal__heading">{{ section.settings.heading | default: "What we've been writing." }}</h2>
    </div>

    <div class="alva-journal__grid">
      {%- if blog != blank -%}
        {%- for article in blog.articles limit: 3 -%}
          <a href="{{ article.url }}" class="alva-journal__card">
            <div class="alva-journal__card-image-wrap">
              {%- if article.image -%}
                <img
                  class="alva-journal__card-image"
                  src="{{ article.image | image_url: width: 800 }}"
                  srcset="
                    {{ article.image | image_url: width: 480 }} 480w,
                    {{ article.image | image_url: width: 800 }} 800w
                  "
                  sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
                  alt="{{ article.image.alt | escape | default: article.title }}"
                  loading="lazy"
                >
              {%- else -%}
                <div class="alva-journal__card-image" style="background-color: var(--cream);"></div>
              {%- endif -%}
            </div>
            {%- if article.tags.size > 0 -%}
              <span class="alva-journal__card-category">{{ article.tags | first }}</span>
            {%- endif -%}
            <h3 class="alva-journal__card-title">{{ article.title }}</h3>
            <span class="alva-journal__card-meta">{{ article.published_at | date: '%d %B %Y' }}</span>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          <div class="alva-journal__card" {{ block.shopify_attributes }}>
            <div class="alva-journal__card-image-wrap">
              {%- if block.settings.image != blank -%}
                <img
                  class="alva-journal__card-image"
                  src="{{ block.settings.image | image_url: width: 800 }}"
                  alt="{{ block.settings.title | escape }}"
                  loading="lazy"
                >
              {%- else -%}
                <div class="alva-journal__card-image" style="background-color: var(--cream);"></div>
              {%- endif -%}
            </div>
            {%- if block.settings.category != blank -%}
              <span class="alva-journal__card-category">{{ block.settings.category }}</span>
            {%- endif -%}
            <h3 class="alva-journal__card-title">{{ block.settings.title }}</h3>
            <span class="alva-journal__card-meta">{{ block.settings.date }}</span>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    <div class="alva-journal__cta">
      <a href="{{ section.settings.cta_link | default: '/blogs/journal' }}" class="alva-journal__link">
        {{ section.settings.cta_label | default: 'All articles' }}
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Journal preview",
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "What we've been writing."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Link label",
      "default": "All articles"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Link URL"
    }
  ],
  "blocks": [
    {
      "type": "article_card",
      "name": "Article card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "category",
          "label": "Category",
          "default": "Fabrics"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "On the cloth we chose and why."
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date",
          "default": "June 2026"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Journal preview"
    }
  ]
}
{% endschema %}
