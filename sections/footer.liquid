<style>
  /* ============================================================
     ALVA FOOTER
     ============================================================ */

  .alva-footer {
    background-color: var(--ink);
    padding: var(--sp-20) var(--container-pad) var(--sp-10);
  }

  @media (min-width: 768px) {
    .alva-footer {
      padding: var(--sp-20) var(--container-pad) var(--sp-8);
    }
  }

  .alva-footer__inner {
    max-width: var(--container-max);
    margin: 0 auto;
  }

  /* 4-column grid */
  .alva-footer__columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-10);
    margin-bottom: var(--sp-12);
  }

  @media (min-width: 768px) {
    .alva-footer__columns {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--sp-8);
    }
  }

  @media (min-width: 1024px) {
    .alva-footer__columns {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--sp-8);
      margin-bottom: var(--sp-20);
    }
  }

  .alva-footer__col-label {
    font-family: var(--font-body);
    font-size: var(--font-eyebrow);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(250, 248, 244, 0.6);
    margin-bottom: var(--sp-6);
    display: block;
  }

  .alva-footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
  }

  .alva-footer__links a {
    font-family: var(--font-body);
    font-size: var(--font-ui-sm);
    font-weight: 300;
    color: rgba(250, 248, 244, 0.8);
    text-decoration: none;
    line-height: 2;
    transition: color 150ms ease-out;
    display: block;
  }

  .alva-footer__links a:hover {
    color: var(--paper);
    text-decoration: none;
  }

  /* Newsletter column */
  .alva-footer__newsletter-form {
    display: flex;
    align-items: stretch;
    gap: 0;
    margin-top: var(--sp-2);
  }

  .alva-footer__newsletter-input {
    flex: 1;
    background: transparent;
    border: 1px solid rgba(250, 248, 244, 0.25);
    border-right: none;
    border-radius: 0 !important;
    padding: var(--sp-3) var(--sp-4);
    font-family: var(--font-body);
    font-size: var(--font-body-sm);
    font-weight: 300;
    color: var(--paper);
    outline: none;
    transition: border-color 150ms ease-out;
  }

  .alva-footer__newsletter-input::placeholder {
    color: rgba(250, 248, 244, 0.4);
  }

  .alva-footer__newsletter-input:focus {
    border-color: rgba(250, 248, 244, 0.6);
  }

  .alva-footer__newsletter-btn {
    background: transparent;
    border: 1px solid rgba(250, 248, 244, 0.25);
    border-radius: 0 !important;
    padding: var(--sp-3) var(--sp-4);
    cursor: pointer;
    color: var(--paper);
    display: flex;
    align-items: center;
    transition: background-color 150ms ease-out, border-color 150ms ease-out;
  }

  .alva-footer__newsletter-btn:hover {
    background-color: rgba(250, 248, 244, 0.1);
    border-color: rgba(250, 248, 244, 0.5);
  }

  .alva-footer__newsletter-btn svg {
    width: 16px;
    height: 16px;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .alva-footer__newsletter-helper {
    font-family: var(--font-body);
    font-size: var(--font-ui-sm);
    font-weight: 300;
    color: rgba(250, 248, 244, 0.4);
    margin-top: var(--sp-2);
    display: block;
  }

  /* Bottom row */
  .alva-footer__bottom {
    padding-top: var(--sp-8);
    border-top: 1px solid rgba(250, 248, 244, 0.12);
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    align-items: flex-start;
  }

  @media (min-width: 768px) {
    .alva-footer__bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .alva-footer__wordmark {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--paper);
    text-decoration: none;
    display: block;
    width: 80px;
    line-height: 1;
  }

  .alva-footer__wordmark:hover {
    color: var(--paper);
    text-decoration: none;
  }

  .alva-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
    align-items: center;
  }

  .alva-footer__legal-text,
  .alva-footer__legal a {
    font-family: var(--font-body);
    font-size: var(--font-ui-sm);
    font-weight: 400;
    color: rgba(250, 248, 244, 0.4);
    text-decoration: none;
    transition: color 150ms ease-out;
  }

  .alva-footer__legal a:hover {
    color: rgba(250, 248, 244, 0.7);
    text-decoration: none;
  }

  .alva-footer__instagram a {
    font-family: var(--font-body);
    font-size: var(--font-ui-sm);
    font-weight: 400;
    color: rgba(250, 248, 244, 0.5);
    text-decoration: none;
    transition: color 150ms ease-out;
  }

  .alva-footer__instagram a:hover {
    color: var(--paper);
    text-decoration: none;
  }
</style>

<footer class="alva-footer">
  <div class="alva-footer__inner">

    <!-- 4-column grid -->
    <div class="alva-footer__columns">

      <!-- Column 1: The Blazer -->
      <div class="alva-footer__col">
        <span class="alva-footer__col-label">The Blazer</span>
        <ul class="alva-footer__links">
          <li><a href="/products/the-unstructured-blazer">The Blazer</a></li>
          <li><a href="/pages/blazer-fabrics">Fabrics</a></li>
          <li><a href="/pages/blazer-construction">Construction</a></li>
          <li><a href="/pages/sizing">Sizing</a></li>
        </ul>
      </div>

      <!-- Column 2: The Brand -->
      <div class="alva-footer__col">
        <span class="alva-footer__col-label">The Brand</span>
        <ul class="alva-footer__links">
          <li><a href="/pages/factory">The Factory</a></li>
          <li><a href="/pages/consultation">Consultation</a></li>
          <li><a href="/blogs/journal">Journal</a></li>
        </ul>
      </div>

      <!-- Column 3: Information -->
      <div class="alva-footer__col">
        <span class="alva-footer__col-label">Information</span>
        <ul class="alva-footer__links">
          <li><a href="/pages/wholesale">Wholesale enquiries</a></li>
          <li><a href="/pages/contact">Contact</a></li>
          <li><a href="/policies/shipping-policy">Shipping</a></li>
          <li><a href="/policies/refund-policy">Returns</a></li>
        </ul>
      </div>

      <!-- Column 4: Newsletter -->
      <div class="alva-footer__col">
        <span class="alva-footer__col-label">Newsletter</span>
        {%- form 'customer', id: 'alva-footer-newsletter' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="alva-footer__newsletter-form">
            <input
              type="email"
              name="contact[email]"
              class="alva-footer__newsletter-input"
              placeholder="Email"
              required
              autocomplete="email"
              aria-label="Email address for newsletter"
            >
            <button type="submit" class="alva-footer__newsletter-btn" aria-label="Subscribe">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </button>
          </div>
          <span class="alva-footer__newsletter-helper">One letter a month. No promotion.</span>
        {%- endform -%}
      </div>

    </div>

    <!-- Bottom row -->
    <div class="alva-footer__bottom">
      <a href="{{ routes.root_url }}" class="alva-footer__wordmark">ALVA</a>

      <div class="alva-footer__legal">
        <span class="alva-footer__legal-text">&copy; {{ 'now' | date: '%Y' }} ALVA &middot; Made in Portugal</span>
        <a href="/policies/privacy-policy">Privacy</a>
        <a href="/policies/terms-of-service">Legal</a>
      </div>

      <div class="alva-footer__instagram">
        <a href="{{ settings.social_instagram_link | default: '#' }}" target="_blank" rel="noopener">Instagram</a>
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": []
}
{% endschema %}
