<style>
  /* ============================================================
     ALVA PRODUCT PAGE
     ============================================================ */

  .alva-product {
    padding: 0;
  }

  /* ---- Desktop 2-column layout ---- */
  .alva-product__layout {
    display: block;
  }

  @media (min-width: 1024px) {
    .alva-product__layout {
      display: grid;
      grid-template-columns: 60fr 40fr;
      gap: var(--sp-20);
      max-width: var(--container-max);
      margin: 0 auto;
      padding: 0 var(--container-pad);
      align-items: start;
    }
  }

  /* ---- Gallery column ---- */
  .alva-product__gallery {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  /* Mobile: horizontal swipe gallery */
  @media (max-width: 1023px) {
    .alva-product__gallery {
      flex-direction: row;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 0;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .alva-product__gallery::-webkit-scrollbar {
      display: none;
    }

    .alva-product__gallery-item {
      flex: 0 0 100%;
      scroll-snap-align: start;
    }
  }

  .alva-product__gallery-item {
    overflow: hidden;
  }

  .alva-product__gallery-image {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    display: block;
  }

  /* ---- Decision panel (sticky on desktop) ---- */
  .alva-product__panel {
    padding: var(--sp-8) var(--container-pad);
  }

  @media (min-width: 1024px) {
    .alva-product__panel {
      padding: var(--sp-10) 0;
      position: sticky;
      top: calc(var(--header-height) + var(--sp-6));
      max-height: calc(100vh - var(--header-height) - var(--sp-12));
      overflow-y: auto;
    }
  }

  /* ---- Panel components ---- */
  .alva-product__brand {
    font-family: var(--font-body);
    font-size: var(--font-eyebrow);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--stone);
    display: block;
    margin-bottom: var(--sp-2);
  }

  .alva-product__title {
    font-family: var(--font-heading);
    font-size: var(--font-display-lg);
    font-weight: 300;
    line-height: 1.1;
    color: var(--ink);
    margin-bottom: var(--sp-2);
  }

  .alva-product__subtitle {
    font-family: var(--font-body);
    font-size: var(--font-body-md);
    font-weight: 300;
    color: var(--stone);
    margin-bottom: var(--sp-8);
    display: block;
  }

  .alva-product__divider {
    height: 1px;
    background-color: var(--sand);
    margin: var(--sp-8) 0;
  }

  /* ---- Fabric swatches ---- */
  .alva-product__section-label {
    font-family: var(--font-body);
    font-size: var(--font-eyebrow);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--stone);
    display: block;
    margin-bottom: var(--sp-4);
  }

  .alva-fabric-swatches {
    display: flex;
    gap: var(--sp-3);
    flex-wrap: wrap;
    margin-bottom: var(--sp-4);
  }

  .alva-swatch {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-2);
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
  }

  .alva-swatch__image {
    width: 56px;
    height: 56px;
    border-radius: 2px;
    border: 1px solid var(--sand);
    object-fit: cover;
    transition: border-color 150ms ease-out, border-width 100ms ease-out;
    display: block;
  }

  @media (min-width: 1024px) {
    .alva-swatch__image {
      width: 64px;
      height: 64px;
    }
  }

  .alva-swatch:hover .alva-swatch__image {
    border-color: var(--warm);
  }

  .alva-swatch.is-selected .alva-swatch__image {
    border: 2px solid var(--ink);
    box-shadow: inset 0 0 0 1px var(--paper);
  }

  .alva-swatch__name {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 400;
    color: var(--charcoal);
    text-align: center;
    line-height: 1.3;
    max-width: 60px;
  }

  /* Fabric info */
  .alva-fabric-info {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 300;
    font-style: italic;
    color: var(--charcoal);
    line-height: 1.55;
    min-height: 28px;
    transition: opacity 200ms ease-out;
  }

  /* ---- Price ---- */
  .alva-product__price {
    font-family: var(--font-heading);
    font-size: 32px;
    font-weight: 300;
    color: var(--ink);
    line-height: 1;
    display: block;
    margin-bottom: var(--sp-2);
  }

  .alva-product__price-note {
    font-family: var(--font-body);
    font-size: var(--font-ui-sm);
    font-weight: 400;
    color: var(--stone);
    display: block;
    margin-bottom: 0;
  }

  /* ---- Size selector ---- */
  .alva-size-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin-bottom: var(--sp-2);
  }

  .alva-size-btn {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-size: var(--font-body-md);
    font-weight: 400;
    color: var(--ink);
    border: 1px solid var(--sand);
    background: transparent;
    cursor: pointer;
    border-radius: 0 !important;
    transition: border-color 150ms ease-out, background-color 150ms ease-out;
  }

  .alva-size-btn:hover {
    border-color: var(--warm);
  }

  .alva-size-btn.is-selected {
    border: 2px solid var(--ink);
    background-color: var(--paper);
  }

  .alva-size-btn.is-unavailable {
    border-color: rgba(196, 184, 168, 0.4);
    color: rgba(107, 94, 78, 0.4);
    text-decoration: line-through;
    cursor: not-allowed;
  }

  .alva-product__size-links {
    display: flex;
    gap: var(--sp-4);
    margin-bottom: var(--sp-6);
  }

  .alva-product__size-links a {
    font-family: var(--font-body);
    font-size: var(--font-body-sm);
    font-weight: 400;
    color: var(--charcoal);
    text-decoration: underline;
    text-decoration-color: var(--sand);
    text-underline-offset: 3px;
    transition: color 150ms ease-out;
  }

  .alva-product__size-links a:hover {
    color: var(--warm);
    text-decoration-color: var(--warm);
    text-decoration: underline;
  }

  /* ---- Stock note ---- */
  .alva-product__stock-note {
    font-family: var(--font-body);
    font-size: var(--font-body-sm);
    font-weight: 300;
    color: var(--charcoal);
    line-height: 1.55;
    margin-bottom: var(--sp-6);
    min-height: 20px;
  }

  /* ---- Add to bag ---- */
  .alva-product__add-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    font-family: var(--font-body);
    font-size: var(--font-ui-md);
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--paper);
    background-color: var(--ink);
    border: 1px solid var(--ink);
    padding: 18px var(--sp-10);
    cursor: pointer;
    border-radius: 0 !important;
    transition: background-color 150ms ease-out;
    margin-bottom: var(--sp-3);
  }

  .alva-product__add-btn:hover {
    background-color: var(--charcoal);
  }

  .alva-product__add-btn:disabled {
    background-color: var(--stone);
    border-color: var(--stone);
    cursor: not-allowed;
  }

  .alva-product__guarantee {
    font-family: var(--font-body);
    font-size: var(--font-ui-sm);
    font-weight: 300;
    color: var(--stone);
    text-align: center;
    display: block;
    margin-bottom: var(--sp-6);
  }

  .alva-product__consult-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    font-family: var(--font-body);
    font-size: var(--font-ui-md);
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--ink);
    background-color: transparent;
    border: 1px solid var(--ink);
    padding: 18px var(--sp-10);
    text-decoration: none;
    border-radius: 0 !important;
    transition: background-color 150ms ease-out, color 150ms ease-out;
  }

  .alva-product__consult-btn:hover {
    background-color: var(--ink);
    color: var(--paper);
    text-decoration: none;
  }

  /* ---- Mobile sticky bar ---- */
  .alva-mobile-sticky-bar {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 90;
    height: 80px;
    background-color: var(--paper);
    border-top: 1px solid var(--sand);
    padding: 0 var(--container-pad);
    align-items: center;
    gap: var(--sp-4);
  }

  @media (max-width: 1023px) {
    .alva-mobile-sticky-bar.is-visible {
      display: flex;
    }
  }

  .alva-mobile-sticky-bar__price {
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 300;
    color: var(--ink);
    flex: 1;
    line-height: 1;
  }

  .alva-mobile-sticky-bar__size {
    font-family: var(--font-body);
    font-size: var(--font-body-sm);
    font-weight: 400;
    color: var(--stone);
    flex: 1;
    text-align: center;
  }

  .alva-mobile-sticky-bar__btn {
    flex: 1;
    height: 48px;
    font-family: var(--font-body);
    font-size: var(--font-ui-md);
    font-weight: 400;
    color: var(--paper);
    background-color: var(--ink);
    border: none;
    cursor: pointer;
    border-radius: 0 !important;
    transition: background-color 150ms ease-out;
  }

  .alva-mobile-sticky-bar__btn:hover {
    background-color: var(--charcoal);
  }

  /* Below-fold sections */
  .alva-product__below-fold {
    margin-top: var(--sp-20);
  }
</style>

{%- assign product = product -%}
{%- assign fabric_option_index = nil -%}
{%- assign size_option_index = nil -%}
{%- for option in product.options -%}
  {%- assign option_downcase = option | downcase -%}
  {%- if option_downcase contains 'fabric' or option_downcase contains 'material' or option_downcase contains 'colour' or option_downcase contains 'color' -%}
    {%- assign fabric_option_index = forloop.index0 -%}
  {%- endif -%}
  {%- if option_downcase contains 'size' -%}
    {%- assign size_option_index = forloop.index0 -%}
  {%- endif -%}
{%- endfor -%}

{%- if fabric_option_index == nil -%}{%- assign fabric_option_index = 0 -%}{%- endif -%}
{%- if size_option_index == nil -%}{%- assign size_option_index = 1 -%}{%- endif -%}

{%- assign fabric_option = product.options[fabric_option_index] -%}
{%- assign size_option = product.options[size_option_index] -%}

{%- assign fabric_values = product.options_with_values[fabric_option_index].values -%}
{%- assign size_values = product.options_with_values[size_option_index].values -%}

<div class="alva-product" id="alva-product">
  <div class="alva-product__layout">

    <!-- LEFT: Image gallery -->
    <div class="alva-product__gallery" id="alva-gallery">
      {%- for media in product.media limit: 8 -%}
        <div class="alva-product__gallery-item">
          <img
            class="alva-product__gallery-image"
            src="{{ media | image_url: width: 1200 }}"
            srcset="
              {{ media | image_url: width: 480 }} 480w,
              {{ media | image_url: width: 768 }} 768w,
              {{ media | image_url: width: 1200 }} 1200w
            "
            sizes="(min-width: 1024px) 60vw, 100vw"
            alt="{{ media.alt | escape | default: product.title }}"
            {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
            width="{{ media.width }}"
            height="{{ media.height }}"
          >
        </div>
      {%- else -%}
        <div class="alva-product__gallery-item">
          <div class="alva-product__gallery-image" style="background-color: var(--cream);"></div>
        </div>
      {%- endfor -%}
    </div>

    <!-- RIGHT: Decision panel -->
    <div class="alva-product__panel" id="alva-panel">

      <span class="alva-product__brand">ALVA</span>
      <h1 class="alva-product__title">{{ product.title }}</h1>
      <span class="alva-product__subtitle">Portuguese Soft Tailoring. Made in our own factory.</span>

      <div class="alva-product__divider"></div>

      <!-- Fabric selector -->
      {%- if fabric_values.size > 0 -%}
        <span class="alva-product__section-label">Choose your fabric</span>
        <div class="alva-fabric-swatches" id="alva-fabric-swatches">
          {%- for value in fabric_values -%}
            {%- assign swatch_color = '#C4B8A8' -%}
            {%- assign value_lower = value | downcase -%}
            {%- if value_lower contains 'navy' and value_lower contains 'honeycomb' -%}{%- assign swatch_color = '#1A2847' -%}
            {%- elsif value_lower contains 'chocolate' -%}{%- assign swatch_color = '#4A2E1A' -%}
            {%- elsif value_lower contains 'denim' -%}{%- assign swatch_color = '#2B4B8C' -%}
            {%- elsif value_lower contains 'melange' -%}{%- assign swatch_color = '#3A4F6B' -%}
            {%- elsif value_lower contains 'pied' -%}{%- assign swatch_color = '#2A2A3A' -%}
            {%- elsif value_lower contains 'beige' -%}{%- assign swatch_color = '#C4B49A' -%}
            {%- elsif value_lower contains 'indigo' -%}{%- assign swatch_color = '#2C3E6B' -%}
            {%- endif -%}
            <button
              class="alva-swatch{% if forloop.first %} is-selected{% endif %}"
              type="button"
              data-fabric="{{ value | escape }}"
              data-option-index="{{ fabric_option_index }}"
              aria-label="{{ value | escape }}"
              aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
            >
              <span
                class="alva-swatch__image"
                style="background-color: {{ swatch_color }};"
                aria-hidden="true"
              ></span>
              <span class="alva-swatch__name">{{ value | split: ' ' | slice: 0, 2 | join: ' ' }}</span>
            </button>
          {%- endfor -%}
        </div>

        <p class="alva-fabric-info" id="alva-fabric-info" aria-live="polite"></p>

        <div class="alva-product__divider"></div>
      {%- endif -%}

      <!-- Price -->
      <span class="alva-product__price" id="alva-price">
        {{ product.selected_or_first_available_variant.price | money_without_trailing_zeros }}
      </span>
      <span class="alva-product__price-note">Made in our factory.</span>

      <div class="alva-product__divider"></div>

      <!-- Size selector -->
      {%- if size_values.size > 0 -%}
        <span class="alva-product__section-label">Size</span>
        <div class="alva-size-grid" id="alva-size-grid">
          {%- for value in size_values -%}
            <button
              class="alva-size-btn"
              type="button"
              data-size="{{ value | escape }}"
              data-option-index="{{ size_option_index }}"
              aria-label="Size {{ value }}"
              aria-pressed="false"
            >{{ value }}</button>
          {%- endfor -%}
        </div>
        <div class="alva-product__size-links">
          <a href="/pages/sizing">Sizing guide</a>
          <a href="/pages/consultation">Not sure? Book a consultation</a>
        </div>
      {%- endif -%}

      <!-- Stock note -->
      <p class="alva-product__stock-note" id="alva-stock-note">Select a fabric and size.</p>

      <!-- Add to cart form -->
      {%- form 'product', product, id: 'alva-product-form', novalidate: 'novalidate' -%}
        <input type="hidden" name="id" id="alva-variant-id" value="{{ product.selected_or_first_available_variant.id }}">
        <button
          type="submit"
          name="add"
          class="alva-product__add-btn"
          id="alva-add-btn"
          disabled
        >
          <span id="alva-add-btn-label">Select a size</span>
        </button>
      {%- endform -%}

      <span class="alva-product__guarantee">30-day satisfaction guarantee. Remake or refund.</span>

      <a href="/pages/consultation" class="alva-product__consult-btn">Book a free consultation</a>

    </div>
  </div>

  <!-- Below fold content -->
  <div class="alva-product__below-fold">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'construction' %}
          <section style="background:var(--cream);padding:var(--sp-32) var(--container-pad);">
            <div style="max-width:var(--container-max);margin:0 auto;">
              <span class="alva-eyebrow" style="display:block;margin-bottom:var(--sp-8);">{{ block.settings.eyebrow | default: 'Construction' }}</span>
              <h2 style="font-family:var(--font-heading);font-size:var(--font-display-md);font-weight:300;color:var(--ink);margin-bottom:var(--sp-8);max-width:640px;">{{ block.settings.heading | default: 'No shoulder padding. No canvas. No lining.' }}</h2>
              <div style="font-family:var(--font-body);font-size:var(--font-body-md);font-weight:300;color:var(--charcoal);max-width:640px;line-height:1.65;">{{ block.settings.body }}</div>
            </div>
          </section>
        {% when 'faq' %}
          <section style="background:var(--paper);padding:var(--sp-32) var(--container-pad);">
            <div style="max-width:720px;margin:0 auto;">
              <span class="alva-eyebrow" style="display:block;margin-bottom:var(--sp-8);">Questions</span>
              <div id="alva-faq">
                {% for sub_block in block.settings %}{% endfor %}
              </div>
            </div>
          </section>
      {% endcase %}
    {% endfor %}
  </div>
</div>

<!-- Mobile sticky bar -->
<div class="alva-mobile-sticky-bar" id="alva-sticky-bar">
  <span class="alva-mobile-sticky-bar__price" id="alva-bar-price">
    {{ product.selected_or_first_available_variant.price | money_without_trailing_zeros }}
  </span>
  <span class="alva-mobile-sticky-bar__size" id="alva-bar-size">Choose size</span>
  <button class="alva-mobile-sticky-bar__btn" id="alva-bar-add-btn" type="button">Add to bag</button>
</div>

<script>
(function() {
  const product = {{ product | json }};
  const variants = product.variants;

  let selectedFabric = null;
  let selectedSize = null;

  const fabricInfoEl = document.getElementById('alva-fabric-info');
  const priceEl = document.getElementById('alva-price');
  const barPriceEl = document.getElementById('alva-bar-price');
  const barSizeEl = document.getElementById('alva-bar-size');
  const stockNoteEl = document.getElementById('alva-stock-note');
  const variantIdInput = document.getElementById('alva-variant-id');
  const addBtn = document.getElementById('alva-add-btn');
  const addBtnLabel = document.getElementById('alva-add-btn-label');
  const barAddBtn = document.getElementById('alva-bar-add-btn');
  const stickyBar = document.getElementById('alva-sticky-bar');
  const panel = document.getElementById('alva-panel');

  // Fabric descriptions
  const fabricDescriptions = {
    'navy honeycomb wool': 'VBC. Founded 1663, Biella. The oldest working wool mill in Europe.',
    'chocolate wool blend': 'Reda. Founded 1865, Biella. Specialists in fine merino.',
    'navy denim': 'Drago. Founded 1875, Biella. Wovens for the European market.',
    'navy melange': 'VBC. Founded 1663, Biella. The oldest working wool mill in Europe.',
    'pied-de-poule navy & black': 'Dormeuil. Founded 1842, London. Cloth suppliers to European tailors for 180 years.',
    'beige wool': 'Reda. Founded 1865, Biella. Specialists in fine merino.',
    'indigo wool blend': 'Drago. Founded 1875, Biella. Wovens for the European market.'
  };

  // Fabric option index
  const fabricOptionIdx = {{ fabric_option_index }};
  const sizeOptionIdx = {{ size_option_index }};

  function getVariant(fabric, size) {
    return variants.find(v => {
      const opts = v.options;
      return opts[fabricOptionIdx] === fabric && opts[sizeOptionIdx] === size;
    });
  }

  function formatPrice(cents) {
    return '€' + Math.round(cents / 100);
  }

  function updatePrice(variant) {
    if (!variant) return;
    const formatted = formatPrice(variant.price);
    if (priceEl) priceEl.textContent = formatted;
    if (barPriceEl) barPriceEl.textContent = formatted;
  }

  function updateStockNote(variant) {
    if (!stockNoteEl) return;
    if (!variant) {
      stockNoteEl.textContent = 'Select a fabric and size.';
      return;
    }
    if (!variant.available) {
      stockNoteEl.textContent = 'Out of stock in this combination.';
      return;
    }
    // Determine RTW vs MTO based on inventory
    if (variant.inventory_management === 'shopify' && variant.inventory_quantity > 0) {
      stockNoteEl.textContent = 'In stock. Delivered in 3–5 working days.';
    } else {
      stockNoteEl.textContent = 'Made to order. Delivered in 2–3 weeks. Free consultation included.';
    }
  }

  function updateAddButton(variant) {
    if (!addBtn || !addBtnLabel) return;
    if (!selectedFabric) {
      addBtnLabel.textContent = 'Select a fabric';
      addBtn.disabled = true;
      return;
    }
    if (!selectedSize) {
      addBtnLabel.textContent = 'Select a size';
      addBtn.disabled = true;
      return;
    }
    if (!variant || !variant.available) {
      addBtnLabel.textContent = 'Unavailable';
      addBtn.disabled = true;
      return;
    }
    // RTW vs MTO label
    if (variant.inventory_management === 'shopify' && variant.inventory_quantity > 0) {
      addBtnLabel.textContent = 'Add to bag';
    } else {
      addBtnLabel.textContent = 'Order — 2 to 3 weeks';
    }
    addBtn.disabled = false;
    if (variantIdInput) variantIdInput.value = variant.id;
  }

  function updateSizeAvailability() {
    const sizeBtns = document.querySelectorAll('.alva-size-btn');
    sizeBtns.forEach(btn => {
      const size = btn.dataset.size;
      if (!selectedFabric) {
        btn.classList.remove('is-unavailable');
        return;
      }
      const variant = getVariant(selectedFabric, size);
      if (!variant || !variant.available) {
        btn.classList.add('is-unavailable');
        if (btn.classList.contains('is-selected')) {
          btn.classList.remove('is-selected');
          btn.setAttribute('aria-pressed', 'false');
          selectedSize = null;
          if (barSizeEl) barSizeEl.textContent = 'Choose size';
        }
      } else {
        btn.classList.remove('is-unavailable');
      }
    });
  }

  function onFabricSelect(btn) {
    const fabric = btn.dataset.fabric;
    if (selectedFabric === fabric) return;
    selectedFabric = fabric;

    document.querySelectorAll('.alva-swatch').forEach(s => {
      s.classList.remove('is-selected');
      s.setAttribute('aria-pressed', 'false');
    });
    btn.classList.add('is-selected');
    btn.setAttribute('aria-pressed', 'true');

    // Update fabric description
    if (fabricInfoEl) {
      const key = fabric.toLowerCase();
      fabricInfoEl.textContent = fabricDescriptions[key] || '';
    }

    updateSizeAvailability();

    const variant = selectedSize ? getVariant(selectedFabric, selectedSize) : null;
    if (variant) updatePrice(variant);
    updateStockNote(variant);
    updateAddButton(variant);
  }

  function onSizeSelect(btn) {
    if (btn.classList.contains('is-unavailable')) return;
    const size = btn.dataset.size;
    selectedSize = size;

    document.querySelectorAll('.alva-size-btn').forEach(s => {
      s.classList.remove('is-selected');
      s.setAttribute('aria-pressed', 'false');
    });
    btn.classList.add('is-selected');
    btn.setAttribute('aria-pressed', 'true');

    if (barSizeEl) barSizeEl.textContent = 'Size ' + size;

    const variant = selectedFabric ? getVariant(selectedFabric, selectedSize) : null;
    if (variant) updatePrice(variant);
    updateStockNote(variant);
    updateAddButton(variant);
  }

  // Attach fabric swatch listeners
  document.querySelectorAll('.alva-swatch').forEach(btn => {
    btn.addEventListener('click', () => onFabricSelect(btn));
  });

  // Attach size button listeners
  document.querySelectorAll('.alva-size-btn').forEach(btn => {
    btn.addEventListener('click', () => onSizeSelect(btn));
  });

  // Bar add btn triggers main form submit
  if (barAddBtn && addBtn) {
    barAddBtn.addEventListener('click', () => addBtn.click());
  }

  // Mobile sticky bar visibility
  if (panel && stickyBar) {
    const observer = new IntersectionObserver((entries) => {
      const panelVisible = entries[0].isIntersecting;
      stickyBar.classList.toggle('is-visible', !panelVisible);
    }, { threshold: 0.1 });
    observer.observe(panel);
  }

  // Auto-select first fabric on load
  const firstSwatch = document.querySelector('.alva-swatch');
  if (firstSwatch) onFabricSelect(firstSwatch);
})();
</script>

